# Public URL. Do not include a trailing slash.
SNAPSENDS3_PUBLIC_HOST=share.example.com
SNAPSENDS3_PUBLIC_ORIGIN=https://share.example.com

# Persistent object storage. Use your Cloudflare R2 S3 API endpoint or an S3 endpoint.
SNAPSENDS3_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
SNAPSENDS3_R2_PUBLIC_ENDPOINT=https://share.example.com
SNAPSENDS3_R2_BUCKET=snapsends3
SNAPSENDS3_R2_ACCESS_KEY_ID=replace-with-access-key-id
SNAPSENDS3_R2_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Replace all development passwords before publishing the service.
SNAPSENDS3_DATABASE_PASSWORD=replace-with-a-long-random-password
SNAPSENDS3_KEYCLOAK_DATABASE_PASSWORD=replace-with-a-long-random-password
SNAPSENDS3_KEYCLOAK_ADMIN_USERNAME=admin
SNAPSENDS3_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
