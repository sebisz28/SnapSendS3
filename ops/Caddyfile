https://localhost {
  tls internal
  handle /api/* {
    reverse_proxy api:8080
  }
  handle /auth/* {
    reverse_proxy keycloak:8080
  }
  handle /snapsends3/* {
    header Content-Disposition "attachment; filename=\"snapsends3-share.zip\""
    reverse_proxy minio:4566
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
