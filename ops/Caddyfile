https://{$SNAPSENDS3_PUBLIC_HOST:localhost} {
  handle /api/* {
    reverse_proxy api:8080
  }
  handle /auth/* {
    reverse_proxy keycloak:8080
  }
  handle /snapsends3/* {
    header Content-Disposition "{query.response-content-disposition}"
    reverse_proxy minio:4566
  }
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
